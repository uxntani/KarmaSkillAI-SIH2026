GEMINI_API_KEY=your_gemini_api_key_here

# Database URL
# For SQLite (default / local development):
# Leave DATABASE_URL unset or use:
# DATABASE_URL=sqlite:///./karmaskill.db
#
# For PostgreSQL (production):
# DATABASE_URL=postgresql://username:password@host:5432/karmaskill_db
#
# Example with Render/Supabase/NeonDB:
# DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb
DATABASE_URL=sqlite:///./karmaskill.db